{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sisp.local/schemas/life-week.schema.json",
  "title": "SISP life ability week detail",
  "type": "object",
  "required": ["schemaVersion", "personId", "domain", "weekId", "sourceType", "representativeSession"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "domain": { "const": "life" },
    "sourceType": { "enum": ["simulation", "real"] },
    "weekId": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "representativeSession": {
      "type": "object",
      "required": ["sessionType", "poseTemplate", "durationSec", "parameters"],
      "properties": {
        "sessionType": { "const": "sit_to_stand" },
        "poseTemplate": { "type": "string" },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "parameters": {
          "type": "object",
          "required": ["powerPhaseSec", "handSupportRatePct", "retryRatePct", "stabilizationSec", "swayHeightPct"],
          "additionalProperties": { "type": "number" }
        }
      }
    }
  }
}
