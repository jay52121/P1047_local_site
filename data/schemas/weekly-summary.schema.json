{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sisp.local/schemas/weekly-summary.schema.json",
  "title": "SISP weekly summary",
  "type": "object",
  "required": ["schemaVersion", "personId", "domain", "sourceType", "weeks"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "personId": { "type": "string", "minLength": 1 },
    "domain": { "enum": ["life", "emotion", "cognition", "sleep", "attention", "participation"] },
    "sourceType": { "enum": ["simulation", "real"] },
    "calculationMode": { "enum": ["migrated-summary", "generated-from-events"] },
    "calculationVersion": { "type": "string" },
    "evidenceOrigin": { "enum": ["reconstructed", "generated", "observed"] },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["weekId", "weekStart", "weekEnd", "status", "confidencePct", "metrics"],
        "properties": {
          "weekId": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
          "weekStart": { "type": "string", "format": "date" },
          "weekEnd": { "type": "string", "format": "date" },
          "status": { "enum": ["complete", "in_progress"] },
          "dataStatus": { "enum": ["sufficient", "partial", "insufficient"] },
          "provisional": { "type": "boolean" },
          "observedThroughDate": { "type": ["string", "null"], "format": "date" },
          "expectedUnits": { "type": "integer", "minimum": 0 },
          "validUnits": { "type": "integer", "minimum": 0 },
          "confidencePct": { "type": "number", "minimum": 0, "maximum": 100 },
          "metricConfidencePct": { "type": "object", "additionalProperties": { "type": ["number", "null"], "minimum": 0, "maximum": 100 } },
          "phase": { "type": ["string", "null"] },
          "event": { "type": ["string", "null"] },
          "eventKind": { "type": ["string", "null"], "enum": ["external", "intervention", "milestone", "data_status", null] },
          "note": { "type": ["string", "null"] },
          "metrics": { "type": "object", "additionalProperties": { "type": ["number", "null"] } },
          "indexes": { "type": "object", "additionalProperties": { "type": ["number", "null"] } },
          "indexComponents": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
