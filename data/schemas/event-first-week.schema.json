{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sisp.local/schemas/event-first-week.schema.json",
  "title": "SISP event-first week detail envelope",
  "type": "object",
  "required": ["schemaVersion", "personId", "domain", "weekId", "sourceType", "calculationMode", "calculationVersion", "evidenceOrigin", "expectedUnits", "units", "weekAggregate"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "personId": { "type": "string", "minLength": 1 },
    "domain": { "enum": ["emotion", "cognition", "sleep", "participation"] },
    "weekId": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "sourceType": { "const": "simulation" },
    "calculationMode": { "const": "generated-from-events" },
    "calculationVersion": { "const": "v2-events-1" },
    "evidenceOrigin": { "const": "generated" },
    "expectedUnits": { "type": "integer", "minimum": 0 },
    "observedThroughDate": { "type": ["string", "null"], "format": "date" },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "valid", "quality", "segments", "events", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "format": "date" },
          "valid": { "type": "boolean" },
          "invalidReason": { "type": ["string", "null"] },
          "observedMinutes": { "type": "number", "minimum": 0 },
          "quality": {
            "type": "object",
            "required": ["coveragePct", "continuityPct", "structuralCompletenessPct", "confidencePct"],
            "properties": {
              "coveragePct": { "type": "number", "minimum": 0, "maximum": 100 },
              "continuityPct": { "type": "number", "minimum": 0, "maximum": 100 },
              "structuralCompletenessPct": { "type": "number", "minimum": 0, "maximum": 100 },
              "confidencePct": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "segments": { "type": "array" },
          "events": { "type": "array" },
          "result": { "type": "object" }
        }
      }
    },
    "weekAggregate": {
      "type": "object",
      "required": ["metrics"],
      "properties": {
        "metrics": { "type": "object", "additionalProperties": { "type": ["number", "null"] } }
      }
    }
  }
}
